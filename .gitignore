# ========================================================
# BRINGLY — .gitignore
# Node.js / Express / MongoDB / EJS Full-Stack Application
# ========================================================

# Dependencies
node_modules/
jspm_packages/
web_modules/

# Environment Variables & Sensitive Credentials
.env
.env.*
!.env.example
*.env

# SSL Private Keys & Certificates
ssl/*.key
ssl/*.pem
*.key
*.pem

# Logs & Debuggers
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Configurations
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Local Tool & AI Agent Directories
.gemini/
.claude/
.cursor/

# Runtime, Temp & Coverage
pids/
*.pid
*.seed
*.pid.lock
lib-cov/
coverage/
*.lcov
.nyc_output/
tmp/
temp/
.cache/
dist/
build/

