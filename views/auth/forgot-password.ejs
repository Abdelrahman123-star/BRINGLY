<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('../components/favicon') %>
    <title data-i18n="auth.forgotPasswordTitle">Forgot Password — BRINGLY</title>
    <link rel="stylesheet" href="/css/login.css">
</head>
<body>
    <div class="container">
        <%- include('../components/backButton') %>
        <div class="form-box">
            <h2 id="title" data-i18n="auth.forgotPasswordTitle">Forgot Password</h2>

            <% if (success) { %>
                <div class="success-message">
                    <span><%= success %></span>
                </div>
            <% } %>

            <form action="/forgot-password" method="POST">
                <div class="input-group">
                    <input type="email" name="email" data-i18n-placeholder="auth.emailPlaceholder" placeholder="Enter your email" required>
                </div>
                <button type="submit" class="btn" data-i18n="auth.sendResetLink">Send Reset Link</button>
                <p class="toggle">
                    <span data-i18n="auth.rememberPassword">Remember your password?</span>
                    <a href="/login" data-i18n="signupPage.login">Login</a>
                </p>
                
                <% if (error) { %>
                    <div class="error-message">
                        <span><%= error %></span>
                    </div>
                <% } %>
            </form>
        </div>
    </div>

    <%- include('../components/switchLanguage') %>
</body>
</html>
