  </style>

  <!-- Modal Script -->
  <script>
    let activeMessageItem = null;

    function formatWhatsApp(rawPhone) {
      if (!rawPhone) return '';
      let clean = rawPhone.replace(/[^0-9]/g, '');
      if (clean.startsWith('01')) {
        clean = '2' + clean;
      } else if (!clean.startsWith('20') && clean.startsWith('1')) {
        clean = '20' + clean;
      }
      return clean;
    }

    function openMessageModal(itemData) {
      const data = (typeof itemData === 'string') ? JSON.parse(itemData) : itemData;
      activeMessageItem = data;

      document.getElementById('modalSubject').textContent = data.topic ? (data.topic + ' — ' + data.name) : 'Client Inquiry';
      document.getElementById('modalTopicPill').textContent = data.topic || 'General Inquiry';
      
      const badge = document.getElementById('modalStatusBadge');
      badge.textContent = data.status.toUpperCase();
      badge.className = 'badge badge-' + data.status;

      document.getElementById('modalClientName').textContent = data.name;
      
      const emailEl = document.getElementById('modalClientEmail');
      emailEl.textContent = data.email;
      emailEl.href = 'mailto:' + encodeURIComponent(data.email) + '?subject=' + encodeURIComponent('Re: ' + (data.topic || 'Inquiry') + ' — BRINGLY Concierge');

      const phoneEl = document.getElementById('modalClientPhone');
      if (data.phone) {
        phoneEl.innerHTML = '<i class="fas fa-phone-alt"></i> ' + data.phone;
      } else {
        phoneEl.textContent = 'Not provided';
      }

      const dateStr = new Date(data.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' });
      document.getElementById('modalClientDate').textContent = dateStr;

      document.getElementById('modalClientMessage').textContent = data.message;

      // WhatsApp quick link
      const waBtn = document.getElementById('modalWhatsAppBtn');
      const cleanPhone = formatWhatsApp(data.phone);
      if (cleanPhone) {
        const text = 'Hello ' + data.name + '! Thank you for reaching out to BRINGLY regarding ' + data.topic + '.\n\n';
        waBtn.href = 'https://wa.me/' + cleanPhone + '?text=' + encodeURIComponent(text);
        waBtn.style.display = 'inline-flex';
      } else {
        waBtn.style.display = 'none';
      }

      // Mailto quick link
      const mailBtn = document.getElementById('modalMailtoBtn');
      mailBtn.href = 'mailto:' + encodeURIComponent(data.email) + '?subject=' + encodeURIComponent('Re: ' + (data.topic || 'Inquiry') + ' — BRINGLY Concierge');

      // Previous reply
      const prevCard = document.getElementById('previousReplyCard');
      if (data.adminReply && data.adminReply.trim() !== '') {
        prevCard.style.display = 'block';
        document.getElementById('modalPreviousReplyText').textContent = data.adminReply;
        const repliedDate = data.repliedAt ? new Date(data.repliedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
        document.getElementById('modalRepliedDate').textContent = repliedDate;
      } else {
        prevCard.style.display = 'none';
      }

      // Status selector and reply box
      document.getElementById('modalStatusSelect').value = data.status || 'read';
      document.getElementById('modalReplyText').value = data.adminReply || '';

      // Form action
      document.getElementById('replyMessageForm').action = '/admin/messages/' + data._id + '/update';

      // Show modal
      document.getElementById('messageModal').style.display = 'flex';
    }

    function closeMessageModal() {
      document.getElementById('messageModal').style.display = 'none';
      activeMessageItem = null;
    }

    // Close on backdrop click
    window.addEventListener('click', function(e) {
      const modal = document.getElementById('messageModal');
      if (e.target === modal) {
        closeMessageModal();
      }
    });

    // Close on Escape key
    window.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        const modal = document.getElementById('messageModal');
        if (modal && modal.style.display !== 'none') {
          closeMessageModal();
        }
      }
    });
  </script>
