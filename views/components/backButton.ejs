<!-- Back Button Component -->
<style>
    .back-button-wrap {
        max-width: 1360px;
        margin: 2rem auto 1rem;
        padding: 0 1.5rem;
        display: flex;
        justify-content: center;
    }

    .back-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        padding: 0.7rem 1.4rem;
        background: #FFFFFF;
        border: 1px solid #E8E0D5;
        border-radius: 9999px;
        color: #1A2238;
        font-family: 'Albert Sans', -apple-system, sans-serif;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 4px 12px -2px rgba(26, 34, 56, 0.06);
        transition: all 0.25s ease;
    }

    .back-button:hover {
        transform: translateX(-3px);
        background: #1A2238;
        border-color: #1A2238;
        color: #FFFFFF;
    }
    [dir="rtl"] .back-button i.fa-arrow-left {
        transform: rotate(180deg);
    }
</style>

<div class="back-button-wrap">
    <button class="back-button" onclick="window.history.back()">
        <i class="fas fa-arrow-left"></i>
        <span data-i18n="common.back">Back</span>
    </button>
</div> 