<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%- include('../components/favicon') %>
  <title data-i18n="contactPage.title">Contact & Sourcing Concierge — BRINGLY</title>

  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  
  <!-- Distinctive Atelier Typographic System -->
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Albert+Sans:wght@400;500;600;700&family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="/css/contactUs.css">
</head>
<body>
  <!-- Header -->
  <%- include('../components/header') %>

  <main class="contact-page-wrapper">
    <div class="contact-container">
      
      <!-- Hero Intro Section -->
      <section class="contact-hero">
        <h1 data-i18n="contactPage.heroTitle">Get in Touch</h1>
        <p data-i18n="contactPage.heroSub">
          Have a question about an item, want to know when our next flight arrives from Germany, or need help with an order? We’re always here to help.
        </p>
      </section>

      <!-- Main Two-Column Grid -->
      <div class="contact-grid">
        
        <!-- Left Column: Direct WhatsApp Touchpoints -->
        <aside class="touchpoints-card" aria-label="WhatsApp Contact Options">
          
          <!-- WhatsApp Box -->
          <div class="wa-spotlight-box">
            <div class="wa-spotlight-header">
              <h2 class="wa-channel-title" data-i18n="contactPage.waTitle">Chat with Us on WhatsApp</h2>
              <div class="wa-status-pill">
                <span class="wa-pulse-dot" aria-hidden="true"></span>
                <span data-i18n="contactPage.availableToday">Available Today</span>
              </div>
            </div>

            <div class="wa-phone-row">
              <span class="wa-phone-number"><i class="fab fa-whatsapp"></i> +20 100 670 9258</span>
            </div>

            <p class="wa-spotlight-desc" data-i18n="contactPage.waDesc">
              Message us directly for quick answers, product details, or custom orders from Germany. We usually reply within a few minutes.
            </p>

            <a href="https://wa.me/201006709258?text=Hello%20BRINGLY!%20I%20have%20an%20inquiry%20regarding%20your%20products." 
               target="_blank" 
               class="btn-primary-wa"
               title="Open WhatsApp Chat">
              <i class="fab fa-whatsapp"></i>
              <span data-i18n="contactPage.startWa">Chat on WhatsApp</span>
            </a>

            <!-- Quick Topic Shortcuts -->
            <div class="wa-quick-topics">
              <span class="wa-quick-topics-label" data-i18n="contactPage.quickTopics">Quick Topics</span>
              <div class="topic-chips">
                <a href="https://wa.me/201006709258?text=Hello!%20I%20need%20assistance%20with%20sizing%20and%20measurements." 
                   target="_blank" 
                   class="topic-chip">
                  <i class="fas fa-ruler-combined"></i> <span data-i18n="contactPage.topicSizing">Sizing &amp; Fit</span>
                </a>
                <a href="https://wa.me/201006709258?text=Hello!%20I%20want%20to%20request%20a%20custom%20item%20from%20Germany." 
                   target="_blank" 
                   class="topic-chip">
                  <i class="fas fa-tshirt"></i> <span data-i18n="contactPage.topicCustom">Custom Order</span>
                </a>
                <a href="https://wa.me/201006709258?text=Hello!%20When%20is%20your%20next%20flight%20from%20Germany%20arriving?" 
                   target="_blank" 
                   class="topic-chip">
                  <i class="fas fa-plane"></i> <span data-i18n="contactPage.topicSourcing">Flight Schedule</span>
                </a>
              </div>
            </div>
          </div>

        </aside>

        <!-- Right Column: Inquiry Message Card -->
        <section class="form-card" id="formCard" aria-label="Contact Message Form">
          
          <div class="form-card-header">
            <h2 data-i18n="contactPage.formTitle">Send Us a Message</h2>
            <p data-i18n="contactPage.formSub">
              Prefer email or want to leave a note? Fill out the form below and we’ll get back to you shortly.
            </p>
          </div>

          <form id="contactForm" class="atelier-form">
            <div class="form-row">
              <div class="form-group">
                <label for="contactName"><span data-i18n="contactPage.nameLabel">Your Full Name</span> <span class="required-mark">*</span></label>
                <input class="form-input" type="text" id="contactName" data-i18n-placeholder="contactPage.namePlaceholder" placeholder="e.g. Layla Hassan" required autocomplete="name">
              </div>
              <div class="form-group">
                <label for="contactPhone" data-i18n="contactPage.phoneLabel">WhatsApp / Phone Number</label>
                <input class="form-input" type="tel" id="contactPhone" data-i18n-placeholder="contactPage.phonePlaceholder" placeholder="e.g. +20 100 123 4567" autocomplete="tel">
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="contactEmail"><span data-i18n="contactPage.emailLabel">Email Address</span> <span class="required-mark">*</span></label>
                <input class="form-input" type="email" id="contactEmail" data-i18n-placeholder="contactPage.emailPlaceholder" placeholder="e.g. layla@example.com" required autocomplete="email">
              </div>
              <div class="form-group">
                <label for="contactTopic"><span data-i18n="contactPage.topicLabel">Topic</span> <span class="required-mark">*</span></label>
                <select class="form-select" id="contactTopic" required>
                  <option value="Product Inquiry" data-i18n="contactPage.topicShowroom">Product Inquiry</option>
                  <option value="Sizing & Fit Question" data-i18n="contactPage.topicConsultation">Sizing &amp; Fit Question</option>
                  <option value="Custom Order from Germany" data-i18n="contactPage.topicSourcingOpt">Custom Order from Germany</option>
                  <option value="General Question" data-i18n="contactPage.topicGeneral">General Question</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label for="contactMessage"><span data-i18n="contactPage.messageLabel">Your Message</span> <span class="required-mark">*</span></label>
              <textarea class="form-textarea" id="contactMessage" data-i18n-placeholder="contactPage.messagePlaceholder" placeholder="Tell us what you're looking for, or ask any questions you have..." required></textarea>
            </div>

            <div class="form-submit-row">
              <button class="btn-submit-concierge" type="submit">
                <span data-i18n="contactPage.sendMessage">Send Message</span>
                <i class="fas fa-arrow-right"></i>
              </button>
              <span class="form-privacy-note" data-i18n="contactPage.privacyNote">We respect your privacy. No spam, ever.</span>
            </div>
          </form>

          <!-- Interactive Success State -->
          <div class="contact-success-card" id="contactSuccessCard" role="alert">
            <div class="success-icon-wrap" aria-hidden="true">
              <i class="fas fa-check"></i>
            </div>
            <h3><span data-i18n="contactPage.thankYou">Thank You</span>, <span id="successClientName">Guest</span></h3>
            <p data-i18n="contactPage.successDesc">
              We've received your message and will get back to you shortly.
            </p>
            <div class="success-actions">
              <a href="#" id="forwardWaBtn" target="_blank" class="btn-secondary-wa">
                <i class="fab fa-whatsapp"></i>
                <span data-i18n="contactPage.forwardWa">Forward to WhatsApp</span>
              </a>
              <button type="button" class="btn-reset-form" id="resetFormBtn" data-i18n="contactPage.sendAnother">
                Send Another Message
              </button>
            </div>
          </div>

        </section>

      </div>

    </div>
  </main>

  <!-- Footer -->
  <%- include('../components/footer') %>

  <script src="/js/contactUs.js"></script>
</body>
</html>
