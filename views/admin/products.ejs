<!-- Live Client-Side Search, Filter & View Toggle Controller -->
<script>
(function() {
  const searchInput = document.getElementById('adminProductSearch');
  const clearBtn = document.getElementById('clearSearchBtn');
  const catFilter = document.getElementById('adminCategoryFilter');
  const stockFilter = document.getElementById('adminStockFilter');
  const gridContainer = document.getElementById('productsGridContainer');
  const tableContainer = document.getElementById('productsTableContainer');
  const emptyState = document.getElementById('noProductsFoundState');
  const btnGrid = document.getElementById('viewModeGrid');
  const btnTable = document.getElementById('viewModeTable');

  function filterItems() {
    const q = (searchInput ? searchInput.value.trim().toLowerCase() : '');
    const cat = (catFilter ? catFilter.value : 'all');
    const stock = (stockFilter ? stockFilter.value : 'all');

    if (clearBtn) clearBtn.style.display = q ? 'block' : 'none';

    let visibleCount = 0;

    // Filter Grid Cards
    const cards = document.querySelectorAll('.admin-product-card');
    cards.forEach(card => {
      const name = (card.dataset.name || '').toLowerCase();
      const pCat = card.dataset.category || '';
      const pStock = parseInt(card.dataset.stock || '0', 10);

      const matchQ = !q || name.includes(q);
      const matchCat = (cat === 'all') || (pCat === cat);
      let matchStock = true;
      if (stock === 'in-stock') matchStock = pStock > 5;
      else if (stock === 'low-stock') matchStock = pStock > 0 && pStock <= 5;
      else if (stock === 'out-of-stock') matchStock = pStock <= 0;

      if (matchQ && matchCat && matchStock) {
        card.style.display = '';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    // Filter Table Rows
    const rows = document.querySelectorAll('.admin-table-row');
    rows.forEach(row => {
      const name = (row.dataset.name || '').toLowerCase();
      const pCat = row.dataset.category || '';
      const pStock = parseInt(row.dataset.stock || '0', 10);

      const matchQ = !q || name.includes(q);
      const matchCat = (cat === 'all') || (pCat === cat);
      let matchStock = true;
      if (stock === 'in-stock') matchStock = pStock > 5;
      else if (stock === 'low-stock') matchStock = pStock > 0 && pStock <= 5;
      else if (stock === 'out-of-stock') matchStock = pStock <= 0;

      if (matchQ && matchCat && matchStock) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });

    if (emptyState) {
      emptyState.style.display = (visibleCount === 0 && cards.length > 0) ? 'flex' : 'none';
    }
  }

  if (searchInput) {
    searchInput.addEventListener('input', filterItems);
  }
  if (clearBtn) {
    clearBtn.addEventListener('click', function() {
      searchInput.value = '';
      filterItems();
      searchInput.focus();
    });
  }
  if (catFilter) catFilter.addEventListener('change', filterItems);
  if (stockFilter) stockFilter.addEventListener('change', filterItems);

  // View mode toggle
  if (btnGrid && btnTable && gridContainer && tableContainer) {
    btnGrid.addEventListener('click', function() {
      btnGrid.classList.add('active');
      btnTable.classList.remove('active');
      gridContainer.style.display = 'grid';
      tableContainer.style.display = 'none';
      try { localStorage.setItem('admin_product_view', 'grid'); } catch(e){}
    });

    btnTable.addEventListener('click', function() {
      btnTable.classList.add('active');
      btnGrid.classList.remove('active');
      gridContainer.style.display = 'none';
      tableContainer.style.display = 'block';
      try { localStorage.setItem('admin_product_view', 'table'); } catch(e){}
    });

    try {
      if (localStorage.getItem('admin_product_view') === 'table') {
        btnTable.click();
      }
    } catch(e){}
  }

  window.resetAdminProductFilters = function() {
    if (searchInput) searchInput.value = '';
    if (catFilter) catFilter.value = 'all';
    if (stockFilter) stockFilter.value = 'all';
    filterItems();
  };
})();

// Atelier Product Reorder Controller
(function() {
  const btnToggleReorder = document.getElementById('btnToggleReorderMode');
  const reorderActionBar = document.getElementById('reorderActionBar');
  const btnSaveReorder = document.getElementById('btnSaveReorder');
  const btnResetReorder = document.getElementById('btnResetReorder');
  const btnExitReorder = document.getElementById('btnExitReorder');
  const reorderBarStatus = document.getElementById('reorderBarStatus');
  const gridContainer = document.getElementById('productsGridContainer');
  const tableContainer = document.getElementById('productsTableContainer');
  const toast = document.getElementById('adminToast');
  const toastMsg = document.getElementById('toastMessage');

  let isReorderMode = false;
  let hasUnsavedChanges = false;
  let draggedElement = null;
  let initialOrder = [];

  function showToast(msg, isError) {
    if (!toast || !toastMsg) return;
    toastMsg.textContent = msg;
    if (isError) {
      toast.classList.add('toast-error');
      const icon = toast.querySelector('.toast-icon');
      if (icon) icon.className = 'toast-icon fas fa-exclamation-circle';
    } else {
      toast.classList.remove('toast-error');
      const icon = toast.querySelector('.toast-icon');
      if (icon) icon.className = 'toast-icon fas fa-check-circle';
    }
    toast.style.display = 'flex';
    clearTimeout(window.toastTimer);
    window.toastTimer = setTimeout(function() {
      toast.style.display = 'none';
    }, 4500);
  }

  function getCardIds() {
    return Array.from(document.querySelectorAll('#productsGridContainer .admin-product-card'))
      .map(function(card) { return card.dataset.id; });
  }

  function captureInitialOrder() {
    initialOrder = getCardIds();
  }

  function updateOrderBadges() {
    const cards = document.querySelectorAll('#productsGridContainer .admin-product-card');
    cards.forEach(function(card, idx) {
      const idxEl = card.querySelector('.order-idx');
      if (idxEl) idxEl.textContent = idx + 1;
    });

    const rows = document.querySelectorAll('#productsTableContainer .admin-table-row');
    rows.forEach(function(row, idx) {
      const idxEl = row.querySelector('.order-idx');
      if (idxEl) idxEl.textContent = idx + 1;
    });
  }

  function syncTableToGrid() {
    const tbody = document.querySelector('#productsTableContainer tbody');
    if (!tbody) return;
    const cards = Array.from(document.querySelectorAll('#productsGridContainer .admin-product-card'));
    const rowsMap = new Map();
    document.querySelectorAll('#productsTableContainer .admin-table-row').forEach(function(row) {
      rowsMap.set(row.dataset.id, row);
    });

    cards.forEach(function(card) {
      const row = rowsMap.get(card.dataset.id);
      if (row) tbody.appendChild(row);
    });
    updateOrderBadges();
  }

  function syncGridToTable() {
    if (!gridContainer) return;
    const rows = Array.from(document.querySelectorAll('#productsTableContainer .admin-table-row'));
    const cardsMap = new Map();
    document.querySelectorAll('#productsGridContainer .admin-product-card').forEach(function(card) {
      cardsMap.set(card.dataset.id, card);
    });

    rows.forEach(function(row) {
      const card = cardsMap.get(row.dataset.id);
      if (card) gridContainer.appendChild(card);
    });
    updateOrderBadges();
  }

  function markModified() {
    hasUnsavedChanges = true;
    if (reorderBarStatus) {
      reorderBarStatus.innerHTML = '<strong style="color: #ff9800;"><i class="fas fa-circle-exclamation"></i> Unsaved order changes!</strong> Click <em>"Save New Order"</em> to publish changes.';
    }
    if (reorderActionBar) reorderActionBar.style.display = 'flex';
  }

  function setupDraggables() {
    const cards = document.querySelectorAll('#productsGridContainer .admin-product-card');
    cards.forEach(function(card) {
      card.setAttribute('draggable', 'true');
      card.addEventListener('dragstart', function(e) {
        draggedElement = card;
        card.classList.add('is-dragging');
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', card.dataset.id);
      });
      card.addEventListener('dragend', function() {
        card.classList.remove('is-dragging');
        document.querySelectorAll('.admin-product-card').forEach(function(c) {
          c.classList.remove('drag-over-before', 'drag-over-after');
        });
        draggedElement = null;
      });
      card.addEventListener('dragover', function(e) {
        e.preventDefault();
        if (!draggedElement || draggedElement === card) return;
        const rect = card.getBoundingClientRect();
        const midX = rect.left + rect.width / 2;
        if (e.clientX < midX) {
          card.classList.add('drag-over-before');
          card.classList.remove('drag-over-after');
        } else {
          card.classList.add('drag-over-after');
          card.classList.remove('drag-over-before');
        }
      });
      card.addEventListener('dragleave', function() {
        card.classList.remove('drag-over-before', 'drag-over-after');
      });
      card.addEventListener('drop', function(e) {
        e.preventDefault();
        card.classList.remove('drag-over-before', 'drag-over-after');
        if (!draggedElement || draggedElement === card) return;
        const rect = card.getBoundingClientRect();
        const midX = rect.left + rect.width / 2;
        if (e.clientX < midX) {
          gridContainer.insertBefore(draggedElement, card);
        } else {
          gridContainer.insertBefore(draggedElement, card.nextSibling);
        }
        syncTableToGrid();
        markModified();
      });
    });

    const rows = document.querySelectorAll('#productsTableContainer .admin-table-row');
    const tbody = document.querySelector('#productsTableContainer tbody');
    if (tbody) {
      rows.forEach(function(row) {
        row.setAttribute('draggable', 'true');
        row.addEventListener('dragstart', function(e) {
          draggedElement = row;
          row.classList.add('is-dragging');
          e.dataTransfer.effectAllowed = 'move';
          e.dataTransfer.setData('text/plain', row.dataset.id);
        });
        row.addEventListener('dragend', function() {
          row.classList.remove('is-dragging');
          document.querySelectorAll('.admin-table-row').forEach(function(r) {
            r.classList.remove('drag-over-before', 'drag-over-after');
          });
          draggedElement = null;
        });
        row.addEventListener('dragover', function(e) {
          e.preventDefault();
          if (!draggedElement || draggedElement === row) return;
          const rect = row.getBoundingClientRect();
          const midY = rect.top + rect.height / 2;
          if (e.clientY < midY) {
            row.classList.add('drag-over-before');
            row.classList.remove('drag-over-after');
          } else {
            row.classList.add('drag-over-after');
            row.classList.remove('drag-over-before');
          }
        });
        row.addEventListener('dragleave', function() {
          row.classList.remove('drag-over-before', 'drag-over-after');
        });
        row.addEventListener('drop', function(e) {
          e.preventDefault();
          row.classList.remove('drag-over-before', 'drag-over-after');
          if (!draggedElement || draggedElement === row) return;
          const rect = row.getBoundingClientRect();
          const midY = rect.top + rect.height / 2;
          if (e.clientY < midY) {
            tbody.insertBefore(draggedElement, row);
          } else {
            tbody.insertBefore(draggedElement, row.nextSibling);
          }
          syncGridToTable();
          markModified();
        });
      });
    }

    // Grid step buttons
    document.querySelectorAll('.card-reorder-strip .btn-step-prev').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        const card = btn.closest('.admin-product-card');
        if (card && card.previousElementSibling) {
          gridContainer.insertBefore(card, card.previousElementSibling);
          syncTableToGrid();
          markModified();
        }
      });
    });
    document.querySelectorAll('.card-reorder-strip .btn-step-next').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        const card = btn.closest('.admin-product-card');
        if (card && card.nextElementSibling) {
          gridContainer.insertBefore(card.nextElementSibling, card);
          syncTableToGrid();
          markModified();
        }
      });
    });

    // Table step buttons
    if (tbody) {
      document.querySelectorAll('.table-reorder-cell .btn-step-prev').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.stopPropagation();
          const row = btn.closest('.admin-table-row');
          if (row && row.previousElementSibling) {
            tbody.insertBefore(row, row.previousElementSibling);
            syncGridToTable();
            markModified();
          }
        });
      });
      document.querySelectorAll('.table-reorder-cell .btn-step-next').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.stopPropagation();
          const row = btn.closest('.admin-table-row');
          if (row && row.nextElementSibling) {
            tbody.insertBefore(row.nextElementSibling, row);
            syncGridToTable();
            markModified();
          }
        });
      });
    }
  }

  function setReorderMode(enable) {
    isReorderMode = enable;
    if (btnToggleReorder) {
      if (enable) btnToggleReorder.classList.add('active');
      else btnToggleReorder.classList.remove('active');
    }
    document.body.classList.toggle('reorder-mode-active', enable);
    if (reorderActionBar) {
      reorderActionBar.style.display = enable ? 'flex' : 'none';
    }
    if (enable) {
      captureInitialOrder();
      if (reorderBarStatus) {
        reorderBarStatus.innerHTML = 'Drag any product or use the stepper buttons to arrange catalog display sequence.';
      }
    }
  }

  if (btnToggleReorder) {
    btnToggleReorder.addEventListener('click', function() {
      setReorderMode(!isReorderMode);
    });
  }

  if (btnExitReorder) {
    btnExitReorder.addEventListener('click', function() {
      if (hasUnsavedChanges) {
        if (confirm('You have unsaved order changes. Do you want to exit without saving?')) {
          if (btnResetReorder) btnResetReorder.click();
          setReorderMode(false);
        }
      } else {
        setReorderMode(false);
      }
    });
  }

  if (btnResetReorder) {
    btnResetReorder.addEventListener('click', function() {
      if (!initialOrder || initialOrder.length === 0) return;
      const cardsMap = new Map();
      document.querySelectorAll('#productsGridContainer .admin-product-card').forEach(function(card) {
        cardsMap.set(card.dataset.id, card);
      });
      initialOrder.forEach(function(id) {
        const card = cardsMap.get(id);
        if (card) gridContainer.appendChild(card);
      });
      syncTableToGrid();
      hasUnsavedChanges = false;
      if (reorderBarStatus) {
        reorderBarStatus.textContent = 'Order restored to original sequence.';
      }
    });
  }

  if (btnSaveReorder) {
    btnSaveReorder.addEventListener('click', async function() {
      const productIds = getCardIds();
      if (!productIds || productIds.length === 0) return;

      const originalHtml = btnSaveReorder.innerHTML;
      btnSaveReorder.disabled = true;
      btnSaveReorder.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';

      try {
        const response = await fetch('/admin/products/reorder', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({ productIds: productIds })
        });

        const data = await response.json();
        if (response.ok && data.success) {
          hasUnsavedChanges = false;
          captureInitialOrder();
          showToast('Product order saved successfully! Storefront updated.');
          if (reorderBarStatus) {
            reorderBarStatus.innerHTML = '<span style="color: #4ade80;"><i class="fas fa-check-circle"></i> Storefront catalog order updated successfully!</span>';
          }
        } else {
          showToast(data.message || 'Failed to update product order.', true);
        }
      } catch (err) {
        console.error('Error saving order:', err);
        showToast('Network error while saving order.', true);
      } finally {
        btnSaveReorder.disabled = false;
        btnSaveReorder.innerHTML = originalHtml;
      }
    });
  }

  window.addEventListener('beforeunload', function(e) {
    if (hasUnsavedChanges) {
      e.preventDefault();
      e.returnValue = '';
    }
  });

  captureInitialOrder();
  setupDraggables();
  updateOrderBadges();
})();
</script>
