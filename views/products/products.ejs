<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%- include('../components/favicon') %>
  <title>
    <%= typeof searchTerm !== 'undefined' && searchTerm ? `Search: "${searchTerm}" — BRINGLY` : (typeof category !== 'undefined' && category ? `${category.name} — BRINGLY` : 'Curated Showroom — BRINGLY') %>
  </title>

  <!-- Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

  <!-- Distinctive Atelier Typographic System -->
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Albert+Sans:wght@400;500;600;700&family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/products.css">
</head>
<body>
  <!-- Header -->
  <%- include('../components/header') %>

  <main class="products-container">

    <!-- Header Section (Contextual: Search vs Category vs Catalog) -->
    <% if (typeof searchTerm !== 'undefined' && searchTerm && searchTerm.trim() !== '') { %>
      <!-- Search Mode Header -->
      <section class="atelier-search-header" aria-label="Search Summary">
        <div class="search-title-row">
          <div class="search-meta">
            <span class="search-count-pill">
              <i class="fas fa-search"></i>
              <span><%= products.length %> <%= products.length === 1 ? 'Curated Piece' : 'Curated Pieces' %> Found</span>
            </span>
            <h1>Search: “<%= searchTerm %>”</h1>
          </div>

          <!-- In-Page Search Refinement -->
          <div class="search-refine-box">
            <form action="/search" method="GET" class="search-refine-form" role="search">
              <i class="fas fa-search" aria-hidden="true"></i>
              <input type="text" name="term" value="<%= searchTerm %>" placeholder="Refine search query..." data-i18n-placeholder="productsCatalog.refineSearch" required autocomplete="off">
              <button type="submit" aria-label="Submit search">
                <i class="fas fa-arrow-right"></i>
              </button>
            </form>
          </div>
        </div>

        <!-- Bespoke European Concierge Sourcing Callout -->
        <div class="search-concierge-callout">
          <div class="callout-info">
            <div class="concierge-callout-icon" aria-hidden="true">
              <i class="fas fa-compass"></i>
            </div>
            <div class="concierge-callout-text">
              <h4 data-i18n="productsCatalog.conciergeQuestion">Searching for a specific “<%= searchTerm %>” model or edition?</h4>
              <p data-i18n="productsCatalog.conciergeDesc">Our European concierge desk can source, inspect, and courier it directly to your doorstep.</p>
            </div>
          </div>
          <a href="https://wa.me/201006709258?text=<%= encodeURIComponent(`Hello BRINGLY! I am searching for '${searchTerm}' and would like to ask your sourcing desk to help source this item for me from Germany.`) %>"
             target="_blank" 
             class="btn-callout-wa"
             title="Request Bespoke Sourcing on WhatsApp">
            <i class="fab fa-whatsapp"></i>
            <span data-i18n="productsCatalog.requestOnWa">Request on WhatsApp</span>
          </a>
        </div>
      </section>

    <% } else if (typeof category !== 'undefined' && category) { %>
      <!-- Category Mode Header -->
      <section class="category-header" aria-label="Category Overview">
        <span class="category-tag" data-i18n="productsCatalog.curatedCollection">Curated Collection</span>
        <h1><%= category.name %></h1>
        <% if (category.description) { %>
          <p><%= category.description %></p>
        <% } %>
      </section>
    <% } %>

    <!-- Filter & Sort Toolbar -->
    <div class="filters-bar" aria-label="Catalog Controls">
      <div class="filter-group">
        <button class="filter-button <%= (typeof currentFilter === 'undefined' || currentFilter === 'all') ? 'active' : '' %>" data-filter="all" data-i18n="productsCatalog.allPieces">
          All Pieces
        </button>
      </div>

      <div class="filter-group">
        <span class="results-count-text">
          <%= products ? products.length : 0 %> <%= (products && products.length === 1) ? 'item' : 'items' %>
        </span>
        <label for="sortSelect" class="visually-hidden" style="position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0,0,0,0);">Sort By</label>
        <select id="sortSelect" class="sort-select" onchange="updateSort(this.value)">
          <option value="newest" <%= (typeof currentSort === 'undefined' || currentSort === 'newest') ? 'selected' : '' %> data-i18n="productsCatalog.newestArrivals">Newest Arrivals</option>
          <option value="rating" <%= (typeof currentSort !== 'undefined' && currentSort === 'rating') ? 'selected' : '' %> data-i18n="productsCatalog.highestRated">Highest Rated</option>
        </select>
      </div>
    </div>

    <!-- Products Grid -->
    <section class="product-list" aria-label="Products List">
      <% if (products && products.length > 0) { %>
        <% products.forEach(product => { 
          const displayPrice = product.hasDiscount ? product.discountedPrice : product.price;
          let targetUrl = product.productLink ? product.productLink.trim() : '';
          const hasRealLink = targetUrl !== '' && !/^(\/|#)/.test(targetUrl);
          if (hasRealLink) {
            if (!/^https?:\/\//i.test(targetUrl)) {
              targetUrl = 'https://' + targetUrl;
            }
          }
          const catThumb = product.thumbnail || product.imageUrl || product.imagePath || (product.images && product.images.length > 0 ? product.images[0] : '') || '/imgs/img-notfound.jpg';
          const cardOnClick = hasRealLink 
            ? "window.open('" + targetUrl + "', '_blank', 'noopener,noreferrer');"
            : "window.location.href='/products/detail/" + product._id + "';";
          const waProductText = "Hello BRINGLY! I am interested in '" + product.name + "'" + (displayPrice ? " (~" + displayPrice + " EGP)" : "") + ". Could you please share more details?";
          const waProductUrl = "https://wa.me/201006709258?text=" + encodeURIComponent(waProductText);
          const waBtnTitle = displayPrice ? ("~ " + Number(displayPrice).toLocaleString('en-US') + " EGP") : "Inquire on WhatsApp";
        %>
          <article class="product-card" onclick="<%= cardOnClick %>" style="cursor: pointer;">
            <div class="product-image">
              <img src="<%= catThumb %>" alt="<%= product.name %>" loading="lazy">

              <div class="product-actions">
                <% if (hasRealLink) { %>
                  <button class="action-button" title="Visit Store" aria-label="Visit Store" onclick="event.stopPropagation(); window.open('<%= targetUrl %>', '_blank', 'noopener,noreferrer');">
                    <i class="fas fa-external-link-alt"></i>
                  </button>
                <% } else { %>
                  <button class="action-button" title="View Details" aria-label="View Details">
                    <i class="fas fa-eye"></i>
                  </button>
                <% } %>
              </div>
            </div>

            <div class="product-info">
              <h3><%= product.name %></h3>

              <!-- Direct WhatsApp Action Button -->
              <div class="product-wa-action">
                <a href="<%= waProductUrl %>" 
                   target="_blank" 
                   class="btn-wa-card"
                   onclick="event.stopPropagation();"
                   title="<%= waBtnTitle %>">
                  <i class="fab fa-whatsapp"></i>
                  <% if (displayPrice && displayPrice > 0) { %>
                    <% if (product.hasDiscount && product.originalPrice > displayPrice) { %>
                      <del class="wa-original-price">~ <%= Number(product.originalPrice).toLocaleString('en-US') %></del>
                    <% } %>
                    <span class="wa-price-val">~ <%= Number(displayPrice).toLocaleString('en-US') %> <span data-i18n="common.egp">EGP</span></span>
                  <% } else { %>
                    <span data-i18n="productsCatalog.inquireOnWa">Inquire on WhatsApp</span>
                  <% } %>
                </a>
              </div>
            </div>
          </article>
        <% }) %>

      <% } else { %>
        <!-- Empty State: Reassuring Atelier Sourcing -->
        <div class="search-empty-state">
          <div class="empty-icon-wrap" aria-hidden="true">
            <i class="fas fa-search-minus"></i>
          </div>
          
          <h2 data-i18n="productsCatalog.noPiecesTitle">No Showroom Pieces Found <%= typeof searchTerm !== 'undefined' && searchTerm ? `for “${searchTerm}”` : '' %></h2>
          <p data-i18n="productsCatalog.noPiecesDesc">
            Our in-stock inventory is carefully curated, but our bespoke Germany Sourcing Desk can source, inspect, and hand-carry any item for you on our next flight.
          </p>

          <div class="empty-actions">
            <% if (typeof searchTerm !== 'undefined' && searchTerm) { %>
              <a href="https://wa.me/201006709258?text=<%= encodeURIComponent(`Hello BRINGLY! I searched for '${searchTerm}' on your store but couldn't find it. Can your sourcing concierge help find and acquire this for me from Germany?`) %>"
                 target="_blank"
                 class="btn-empty-wa">
                <i class="fab fa-whatsapp"></i>
                <span data-i18n="productsCatalog.askOnWa">Ask BRINGLY on WhatsApp</span>
              </a>
            <% } else { %>
              <a href="https://wa.me/201006709258?text=Hello%20BRINGLY!%20I%20am%20looking%20for%20a%20specific%20item%20and%20need%20concierge%20assistance."
                 target="_blank"
                 class="btn-empty-wa">
                <i class="fab fa-whatsapp"></i>
                <span data-i18n="productsCatalog.askOnWa">Ask BRINGLY on WhatsApp</span>
              </a>
            <% } %>

            <a href="/Category" class="btn-empty-browse" data-i18n="productsCatalog.browseAllCollections">
              Browse All Collections
            </a>
          </div>
        </div>
      <% } %>
    </section>

  </main>

  <!-- Footer -->
  <%- include('../components/footer') %>

  <!-- Search & Filter Persistence Script -->
  <script>
    function updateSort(value) {
      const url = new URL(window.location.href);
      url.searchParams.set('sort', value);
      window.location.href = url.toString();
    }

    document.addEventListener('DOMContentLoaded', function () {
      const filterButtons = document.querySelectorAll('.filter-button');
      filterButtons.forEach(btn => {
        btn.addEventListener('click', function () {
          const filter = this.dataset.filter;
          const url = new URL(window.location.href);
          if (filter === 'all') {
            url.searchParams.delete('filter');
          } else {
            url.searchParams.set('filter', filter);
          }
          window.location.href = url.toString();
        });
      });
    });
  </script>
</body>
</html>
