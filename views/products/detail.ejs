<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../components/favicon') %>
    <!-- dah btaa3 el icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <!-- Distinctive Atelier Typographic System -->
    <link
        href="https://fonts.googleapis.com/css2?family=Marcellus&family=Albert+Sans:wght@400;500;600;700&family=Cairo:wght@400;600;700&display=swap"
        rel="stylesheet">

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title data-i18n="productDetailPage.title">
        <%= product.name %> — BRINGLY
    </title>
    <link rel="stylesheet" href="/css/productsAndCart.css">

    <!-- Add i18next and plugins from CDN -->
    <script src="https://unpkg.com/i18next/dist/umd/i18next.min.js"></script>
    <script src="https://unpkg.com/i18next-http-backend/i18nextHttpBackend.min.js"></script>
    <script src="https://unpkg.com/i18next-browser-languagedetector/i18nextBrowserLanguageDetector.min.js"></script>
    <script src="/js/i18n.js"></script>

    <style>
        /* Add these styles to your existing styles */
        .stock-status {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 500;
            margin: 1rem 0;
        }

        .stock-count {
            font-size: 0.85rem;
            opacity: 0.8;
        }

        .quantity button:disabled,
        .quantity input:disabled,
        .add-to-cart:disabled,
        .buy-now:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .quantity input {
            width: 60px;
            height: 40px;
            text-align: center;
            border: 2px solid #f1f2f6;
            border-radius: 8px;
            font-size: 1.1rem;
        }

        .quantity input:invalid {
            border-color: #e74c3c;
        }

        .quantity button {
            width: 40px;
            height: 40px;
            border: none;
            background: #f1f2f6;
            border-radius: 50%;
            font-size: 1.2rem;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .quantity button:not(:disabled):hover {
            background: #00b894;
            color: white;
        }

        .product-container {
            max-width: 1200px;
            margin: 2rem auto;
            padding: 0 1rem;
        }

        /* Custom Notification Styles */
        .custom-notification {
            position: fixed;
            top: 20px;
            right: 20px;
            padding: 15px 25px;
            background: linear-gradient(45deg, #00b894, #0984e3);
            color: white;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            z-index: 1000;
            transform: translateX(120%);
            transition: transform 0.3s ease-in-out;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .custom-notification.show {
            transform: translateX(0);
        }

        .custom-notification i {
            font-size: 1.2rem;
        }

        .custom-notification .message {
            font-size: 1rem;
            font-weight: 500;
        }

        /* Simple Notification */
        #cart-message {
            position: fixed;
            top: 6em;
            right: 6em;
            background: #00b894;
            color: white;
            padding: 15px 25px;
            border-radius: 8px;
            text-align: center;
            display: none;
            /* Show with JS or as needed */

        }
    </style>
</head>

<body>
    <!-- Header -->
    <%- include('../components/header') %>
        <%- include('../components/backButton') %>
            <%- include('../components/switchLanguage') %>
                <div id="cart-message" data-i18n="productDetailPage.actions.addToCart">Item has been added to cart!
                </div>

                <main class="product-container">
                    <div class="product-layout">
                        <!-- Left Column: Product Images -->
                        <div class="product-gallery">
                            <% 
                                const mainDetailImg = product.thumbnail || product.imageUrl || product.imagePath ||
                                    (product.images && product.images.length > 0 ? product.images[0] : '') ||
                                    '/imgs/img-notfound.jpg';

                                let galleryImages = [];
                                if (product.images && Array.isArray(product.images) && product.images.length > 0) {
                                    galleryImages = product.images.filter(Boolean);
                                }
                                if (galleryImages.length === 0) {
                                    if (product.thumbnail) galleryImages.push(product.thumbnail);
                                    if (product.imageUrl && !galleryImages.includes(product.imageUrl)) galleryImages.push(product.imageUrl);
                                    if (product.imagePath && !galleryImages.includes(product.imagePath)) galleryImages.push(product.imagePath);
                                }
                                if (mainDetailImg && !galleryImages.includes(mainDetailImg) && mainDetailImg !== '/imgs/img-notfound.jpg') {
                                    galleryImages.unshift(mainDetailImg);
                                }
                            %>

                            <div class="main-image-stage" id="mainImageStage" onclick="openZoomModal(event)" title="Click to zoom and pan">
                                <img id="mainDetailImg" src="<%= mainDetailImg %>" alt="<%= product.name %>" class="main-image">
                                <button type="button" class="zoom-action-badge" onclick="openZoomModal(event)" aria-label="Zoom and inspect image">
                                    <i class="fas fa-search-plus"></i>
                                    <span>Zoom & Inspect</span>
                                </button>
                            </div>

                            <% if (galleryImages && galleryImages.length > 1) { %>
                                <div class="detail-gallery-strip">
                                    <% galleryImages.forEach(function(imgUrl, idx) { %>
                                        <button type="button" class="detail-thumb-card <%= (idx === 0) ? 'active' : '' %>"
                                            onclick="switchDetailPhoto(this, '<%= imgUrl %>', <%= idx %>)"
                                            aria-label="View photo <%= idx + 1 %>">
                                            <img src="<%= imgUrl %>" alt="<%= product.name %>">
                                        </button>
                                    <% }); %>
                                </div>
                            <% } %>
                        </div>

                        <!-- Right Column: Product Info -->
                        <div class="product-info">
                            <div class="product-header">
                                <h1 class="product-title">
                                    <%= product.name %>
                                </h1>
                                <% if (false) { /* Reviews & rating hidden for now */ %>
                                <div class="product-rating">
                                    <div class="stars">
                                        <% for(let i=1; i <=5; i++) { %>
                                            <i
                                                class="fas fa-star <%= i <= Math.round(product.rating) ? 'active' : '' %>"></i>
                                            <% } %>
                                    </div>
                                    <span class="rating-count">(<%= product.numberOfReviews %> <span
                                                data-i18n="productDetailPage.reviews.reviews">reviews</span>)</span>
                                </div>
                                <% } %>
                            </div>

                            <% if (product.price && product.price > 0) { %>
                                <div class="product-price-row" style="margin: 0.75rem 0 1rem; font-size: 1.6rem; font-weight: 700; color: #1A2238;">
                                    ~ <%= Number(product.price).toLocaleString('en-US') %> <span style="font-size: 0.95rem; font-weight: 500; color: #64748b;">EGP</span>
                                </div>
                            <% } %>

                            <div class="product-description">
                                <h3 data-i18n="productDetailPage.description">Craft & Details</h3>
                                <div class="product-description-content">
                                    <%- product.description ? (/<[a-z][\s\S]*>/i.test(product.description) ? product.description : product.description.replace(/\n/g, '<br>')) : '' %>
                                </div>
                            </div>
                            <div
                                class="stock-status <%= product.stock > 10 ? 'in-stock' : (product.stock > 0 ? 'low-stock' : 'out-of-stock') %>">
                                <i
                                    class="fas <%= product.stock > 10 ? 'fa-check-circle' : (product.stock > 0 ? 'fa-exclamation-circle' : 'fa-times-circle') %>"></i>
                                <span
                                    data-i18n="productDetailPage.stock.<%= product.stock > 10 ? 'inStock' : (product.stock > 0 ? 'lowStock' : 'outOfStock') %>">
                                    <%= product.stock > 10 ? 'In Stock' : (product.stock > 0 ? 'Low Stock' : 'Out of Stock') %>
                                </span>
                                <% if (product.stock > 0) { %>
                                    <span class="stock-count">(<%= product.stock %> <span
                                                data-i18n="productDetailPage.stock.available">available</span>)</span>
                                    <% } %>
                            </div>

                            <!-- WhatsApp Inquiry & Ordering -->
                            <div class="product-actions-box" style="margin-top: 1.5rem; display: flex; flex-direction: column; gap: 10px;">
                                <% if (product.productLink && product.productLink.trim() !== '') { %>
                                    <% 
                                      let pLink = product.productLink.trim();
                                      if (!/^https?:\/\//i.test(pLink)) pLink = 'https://' + pLink;
                                    %>
                                    <a href="<%= pLink %>" target="_blank" rel="noopener noreferrer" class="btn-detail-wa" style="background: #1A2238;">
                                        <i class="fas fa-external-link-alt"></i>
                                        <span>Visit Original Store</span>
                                    </a>
                                <% } %>
                                <%
                                    const waDetailMsg = "Hello BRINGLY! I am interested in '" + product.name + "'" + (product.price ? " (~" + product.price + " EGP)" : "") + ". Could you please share more details?";
                                    const waDetailUrl = "https://wa.me/201006709258?text=" + encodeURIComponent(waDetailMsg);
                                %>
                                <a href="<%= waDetailUrl %>"
                                    target="_blank" class="btn-detail-wa" title="Inquire on WhatsApp">
                                    <i class="fab fa-whatsapp"></i>
                                    <span>Inquire & Order on WhatsApp</span>
                                </a>
                            </div>
                        </div>
                    </div>

                    <% /* Customer reviews and comments section disabled per request */ %>

                    <section class="related-products-section">
                        <h3 data-i18n="productDetailPage.relatedProducts.title">More Products You Might Like</h3>
                        <div class="related-products-grid">
                            <% if (relatedProducts && relatedProducts.length > 0) { %>
                                <% relatedProducts.forEach(function(relatedProduct) { %>
                                    <div class="related-product-card"
                                        onclick="window.location.href='/products/detail/<%= relatedProduct._id %>'">
                                        <% if (relatedProduct.imageUrl && relatedProduct.imageUrl.trim() !== '') { %>
                                            <img src="<%= relatedProduct.imageUrl %>" alt="<%= relatedProduct.name %>">
                                            <% } else if (relatedProduct.imagePath && relatedProduct.imagePath.trim()
                                                !== '') { %>
                                                <img src="<%= relatedProduct.imagePath %>"
                                                    alt="<%= relatedProduct.name %>">
                                                <% } else { %>
                                                    <img src="/imgs/img-notfound.jpg" alt="Image Not Found">
                                                    <% } %>
                                                        <div class="related-product-info">
                                                            <p class="related-product-name">
                                                                <%= relatedProduct.name %>
                                                            </p>
                                                            <span class="related-product-tag">Explore Piece</span>
                                                        </div>
                                    </div>
                                    <% }) %>
                                        <% } else { %>
                                            <p class="no-related-products"
                                                data-i18n="productDetailPage.relatedProducts.noProducts">No related
                                                products found.</p>
                                            <% } %>
                        </div>
                    </section>
                </main>

                <!-- Fullscreen Interactive Zoom & Pan Modal -->
                <div id="productZoomModal" class="product-zoom-modal" role="dialog" aria-modal="true" aria-label="Product Image Viewer">
                    <!-- Top Navigation & Controls Bar -->
                    <div class="zoom-modal-topbar">
                        <div class="zoom-title-area">
                            <span class="zoom-title-text"><%= product.name %></span>
                            <% if (galleryImages && galleryImages.length > 1) { %>
                                <span class="zoom-counter" id="zoomCounter">1 / <%= galleryImages.length %></span>
                            <% } %>
                        </div>

                        <div class="zoom-controls">
                            <div class="zoom-pill-group">
                                <button type="button" class="zoom-btn" onclick="zoomOut()" title="Zoom Out (-)" aria-label="Zoom Out">
                                    <i class="fas fa-minus"></i>
                                </button>
                                <button type="button" class="zoom-btn zoom-level-btn" onclick="resetZoom()" title="Reset to 100% Fit" aria-label="Reset Zoom">
                                    <span id="zoomLevelDisplay">100%</span>
                                </button>
                                <button type="button" class="zoom-btn" onclick="zoomIn()" title="Zoom In (+)" aria-label="Zoom In">
                                    <i class="fas fa-plus"></i>
                                </button>
                                <button type="button" class="zoom-btn zoom-fs-btn" id="zoomFsBtn" onclick="toggleZoomFullscreen()" title="Toggle Fullscreen" aria-label="Toggle Fullscreen">
                                    <i class="fas fa-expand"></i>
                                </button>
                            </div>
                            <button type="button" class="zoom-btn zoom-close-btn" onclick="closeZoomModal()" title="Close Viewer (Esc)" aria-label="Close Viewer">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Main Viewing Stage & Viewport -->
                    <div class="zoom-viewport" id="zoomViewport">
                        <div class="zoom-stage" id="zoomStage">
                            <img id="zoomModalImg" src="<%= mainDetailImg %>" alt="<%= product.name %>" draggable="false">
                        </div>

                        <% if (galleryImages && galleryImages.length > 1) { %>
                            <button type="button" class="zoom-nav-btn zoom-nav-prev" onclick="navigateZoom(-1)" aria-label="Previous photo">
                                <i class="fas fa-chevron-left"></i>
                            </button>
                            <button type="button" class="zoom-nav-btn zoom-nav-next" onclick="navigateZoom(1)" aria-label="Next photo">
                                <i class="fas fa-chevron-right"></i>
                            </button>
                        <% } %>
                    </div>

                    <!-- In-Modal Floating Thumbnail Gallery Dock -->
                    <% if (galleryImages && galleryImages.length > 1) { %>
                        <div class="zoom-thumb-dock" id="zoomThumbDock">
                            <div class="zoom-thumb-track">
                                <% galleryImages.forEach(function(imgUrl, idx) { %>
                                    <button type="button" class="zoom-thumb-item <%= (idx === 0) ? 'active' : '' %>"
                                        onclick="switchDetailPhoto(this, '<%= imgUrl %>', <%= idx %>)"
                                        data-zoom-idx="<%= idx %>"
                                        aria-label="Switch to angle <%= idx + 1 %>">
                                        <img src="<%= imgUrl %>" alt="<%= product.name %> view <%= idx + 1 %>">
                                    </button>
                                <% }); %>
                            </div>
                        </div>
                    <% } %>

                    <!-- Adaptive Bottom Hints Bar -->
                    <div class="zoom-hint-bar" id="zoomHintBar">
                        <span class="desktop-hints"><i class="fas fa-search-plus"></i> Click or double-click to zoom • Drag to pan • Scroll wheel to zoom • Esc to close</span>
                        <span class="mobile-hints"><i class="fas fa-hand-pointer"></i> Double-tap to zoom • Pinch to expand • Swipe to browse angles</span>
                    </div>
                </div>

                <%- include('../components/footer') %>

                    <script src="/js/product_cart.js"></script>
                    <script>
                        // Interactive Atelier Zoom & Pan Viewer Controller
                        (function() {
                            var galleryPhotos = <%- JSON.stringify(galleryImages) %>;
                            var currentPhotoIndex = 0;
                            var zoomScale = 1;
                            var zoomTransX = 0;
                            var zoomTransY = 0;
                            var isPanning = false;
                            var startPointerX = 0;
                            var startPointerY = 0;
                            var startTransX = 0;
                            var startTransY = 0;
                            var dragDistance = 0;
                            var lastTapTime = 0;
                            var touchStartX = 0;
                            var touchStartY = 0;

                            function updateTransform(disableTransition) {
                                var stage = document.getElementById('zoomStage');
                                var viewport = document.getElementById('zoomViewport');
                                var levelText = document.getElementById('zoomLevelDisplay');
                                if (!stage) return;

                                if (disableTransition) {
                                    stage.classList.add('no-transition');
                                } else {
                                    stage.classList.remove('no-transition');
                                }

                                stage.style.transform = 'translate3d(' + zoomTransX + 'px, ' + zoomTransY + 'px, 0) scale(' + zoomScale + ')';
                                if (levelText) levelText.textContent = Math.round(zoomScale * 100) + '%';

                                if (viewport) {
                                    if (zoomScale > 1) {
                                        viewport.classList.add('is-zoomed');
                                    } else {
                                        viewport.classList.remove('is-zoomed');
                                        viewport.classList.remove('is-dragging');
                                    }
                                }
                            }

                            window.resetZoom = function() {
                                zoomScale = 1;
                                zoomTransX = 0;
                                zoomTransY = 0;
                                updateTransform(false);
                            };

                            window.zoomIn = function() {
                                zoomScale = Math.min(4.5, Math.round((zoomScale + 0.5) * 10) / 10);
                                updateTransform(false);
                            };

                            window.zoomOut = function() {
                                zoomScale = Math.max(1, Math.round((zoomScale - 0.5) * 10) / 10);
                                if (zoomScale === 1) {
                                    zoomTransX = 0;
                                    zoomTransY = 0;
                                }
                                updateTransform(false);
                            };

                            window.toggleZoomFullscreen = function() {
                                var modal = document.getElementById('productZoomModal');
                                var fsBtn = document.getElementById('zoomFsBtn');
                                if (!modal) return;

                                if (!document.fullscreenElement) {
                                    if (modal.requestFullscreen) modal.requestFullscreen().catch(function(){});
                                    else if (modal.webkitRequestFullscreen) modal.webkitRequestFullscreen();
                                    if (fsBtn) fsBtn.innerHTML = '<i class="fas fa-compress"></i>';
                                } else {
                                    if (document.exitFullscreen) document.exitFullscreen().catch(function(){});
                                    else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
                                    if (fsBtn) fsBtn.innerHTML = '<i class="fas fa-expand"></i>';
                                }
                            };

                            function updateCounter() {
                                var counter = document.getElementById('zoomCounter');
                                if (counter && galleryPhotos.length > 0) {
                                    counter.textContent = (currentPhotoIndex + 1) + ' / ' + galleryPhotos.length;
                                }
                            }

                            window.openZoomModal = function(e) {
                                if (e) {
                                    e.preventDefault();
                                    e.stopPropagation();
                                }
                                var modal = document.getElementById('productZoomModal');
                                var zoomImg = document.getElementById('zoomModalImg');
                                var mainImg = document.getElementById('mainDetailImg');
                                if (!modal) return;

                                if (mainImg && zoomImg) {
                                    zoomImg.src = mainImg.src;
                                }
                                updateCounter();
                                resetZoom();
                                modal.classList.add('active');
                                document.body.style.overflow = 'hidden';

                                document.querySelectorAll('.zoom-thumb-item').forEach(function(el, i) {
                                    el.classList.toggle('active', i === currentPhotoIndex);
                                });
                            };

                            window.closeZoomModal = function() {
                                var modal = document.getElementById('productZoomModal');
                                if (!modal) return;
                                if (document.fullscreenElement) {
                                    try { document.exitFullscreen(); } catch(err){}
                                }
                                modal.classList.remove('active');
                                document.body.style.overflow = '';
                                resetZoom();
                            };

                            window.switchDetailPhoto = function(element, src, idx) {
                                var mainImg = document.getElementById('mainDetailImg');
                                var zoomImg = document.getElementById('zoomModalImg');
                                if (mainImg) mainImg.src = src;
                                if (zoomImg) {
                                    zoomImg.classList.add('fading');
                                    setTimeout(function() {
                                        zoomImg.src = src;
                                        zoomImg.classList.remove('fading');
                                    }, 80);
                                }

                                if (typeof idx === 'number') {
                                    currentPhotoIndex = idx;
                                } else {
                                    var foundIdx = galleryPhotos.indexOf(src);
                                    if (foundIdx !== -1) currentPhotoIndex = foundIdx;
                                }

                                document.querySelectorAll('.detail-thumb-card').forEach(function(el, i) {
                                    el.classList.toggle('active', i === currentPhotoIndex);
                                    if (i === currentPhotoIndex && el.scrollIntoView) {
                                        el.scrollIntoView({ behavior: 'smooth', inline: 'nearest', block: 'nearest' });
                                    }
                                });

                                document.querySelectorAll('.zoom-thumb-item').forEach(function(el, i) {
                                    el.classList.toggle('active', i === currentPhotoIndex);
                                    if (i === currentPhotoIndex && el.scrollIntoView) {
                                        el.scrollIntoView({ behavior: 'smooth', inline: 'nearest', block: 'nearest' });
                                    }
                                });

                                updateCounter();
                                resetZoom();
                            };

                            window.navigateZoom = function(dir) {
                                if (!galleryPhotos || galleryPhotos.length <= 1) return;
                                currentPhotoIndex = (currentPhotoIndex + dir + galleryPhotos.length) % galleryPhotos.length;
                                var nextSrc = galleryPhotos[currentPhotoIndex];
                                switchDetailPhoto(null, nextSrc, currentPhotoIndex);
                            };

                            document.addEventListener('DOMContentLoaded', function() {
                                var viewport = document.getElementById('zoomViewport');
                                var modal = document.getElementById('productZoomModal');
                                if (!viewport || !modal) return;

                                // Mouse Drag to Pan
                                viewport.addEventListener('mousedown', function(e) {
                                    if (e.target.closest('.zoom-nav-btn') || e.target.closest('.zoom-thumb-dock')) return;
                                    isPanning = true;
                                    dragDistance = 0;
                                    startPointerX = e.clientX;
                                    startPointerY = e.clientY;
                                    startTransX = zoomTransX;
                                    startTransY = zoomTransY;
                                    if (zoomScale > 1) {
                                        viewport.classList.add('is-dragging');
                                    }
                                });

                                window.addEventListener('mousemove', function(e) {
                                    if (!isPanning) return;
                                    var dx = e.clientX - startPointerX;
                                    var dy = e.clientY - startPointerY;
                                    dragDistance += Math.abs(dx) + Math.abs(dy);
                                    if (zoomScale > 1) {
                                        zoomTransX = startTransX + dx;
                                        zoomTransY = startTransY + dy;
                                        updateTransform(true);
                                    }
                                });

                                window.addEventListener('mouseup', function() {
                                    if (!isPanning) return;
                                    isPanning = false;
                                    viewport.classList.remove('is-dragging');
                                });

                                // Click on viewport: toggle zoom or reset
                                viewport.addEventListener('click', function(e) {
                                    if (e.target.closest('.zoom-nav-btn') || e.target.closest('.zoom-thumb-dock')) return;
                                    if (dragDistance > 6) return;

                                    if (zoomScale === 1) {
                                        var rect = viewport.getBoundingClientRect();
                                        var clickX = e.clientX - (rect.left + rect.width / 2);
                                        var clickY = e.clientY - (rect.top + rect.height / 2);
                                        zoomScale = 2.4;
                                        zoomTransX = -clickX * 1.2;
                                        zoomTransY = -clickY * 1.2;
                                        updateTransform(false);
                                    } else {
                                        resetZoom();
                                    }
                                });

                                // Mouse Wheel Zoom
                                viewport.addEventListener('wheel', function(e) {
                                    e.preventDefault();
                                    var delta = e.deltaY < 0 ? 0.35 : -0.35;
                                    var prevScale = zoomScale;
                                    var nextScale = Math.min(4.5, Math.max(1, Math.round((zoomScale + delta) * 10) / 10));

                                    if (nextScale !== prevScale) {
                                        zoomScale = nextScale;
                                        if (zoomScale === 1) {
                                            zoomTransX = 0;
                                            zoomTransY = 0;
                                        }
                                        updateTransform(false);
                                    }
                                }, { passive: false });

                                // Touch Gestures: Pinch, Pan, Double-Tap, and Swipe Navigation
                                var initialTouchDist = 0;
                                var initialTouchScale = 1;

                                viewport.addEventListener('touchstart', function(e) {
                                    if (e.touches.length === 1) {
                                        isPanning = true;
                                        dragDistance = 0;
                                        startPointerX = e.touches[0].clientX;
                                        startPointerY = e.touches[0].clientY;
                                        touchStartX = e.touches[0].clientX;
                                        touchStartY = e.touches[0].clientY;
                                        startTransX = zoomTransX;
                                        startTransY = zoomTransY;
                                    } else if (e.touches.length === 2) {
                                        isPanning = false;
                                        initialTouchDist = Math.hypot(
                                            e.touches[0].clientX - e.touches[1].clientX,
                                            e.touches[0].clientY - e.touches[1].clientY
                                        );
                                        initialTouchScale = zoomScale;
                                    }
                                }, { passive: true });

                                viewport.addEventListener('touchmove', function(e) {
                                    if (e.touches.length === 1 && isPanning && zoomScale > 1) {
                                        var dx = e.touches[0].clientX - startPointerX;
                                        var dy = e.touches[0].clientY - startPointerY;
                                        dragDistance += Math.abs(dx) + Math.abs(dy);
                                        zoomTransX = startTransX + dx;
                                        zoomTransY = startTransY + dy;
                                        updateTransform(true);
                                    } else if (e.touches.length === 2 && initialTouchDist > 0) {
                                        var dist = Math.hypot(
                                            e.touches[0].clientX - e.touches[1].clientX,
                                            e.touches[0].clientY - e.touches[1].clientY
                                        );
                                        var scaleRatio = dist / initialTouchDist;
                                        zoomScale = Math.min(4.5, Math.max(1, Math.round(initialTouchScale * scaleRatio * 10) / 10));
                                        updateTransform(true);
                                    }
                                }, { passive: true });

                                viewport.addEventListener('touchend', function(e) {
                                    if (e.touches.length === 0) {
                                        isPanning = false;
                                        var now = Date.now();
                                        var tapInterval = now - lastTapTime;

                                        // Double Tap to Zoom / Reset on mobile
                                        if (tapInterval < 320 && dragDistance < 10) {
                                            if (zoomScale === 1) {
                                                var rect = viewport.getBoundingClientRect();
                                                var clickX = startPointerX - (rect.left + rect.width / 2);
                                                var clickY = startPointerY - (rect.top + rect.height / 2);
                                                zoomScale = 2.4;
                                                zoomTransX = -clickX * 1.2;
                                                zoomTransY = -clickY * 1.2;
                                                updateTransform(false);
                                            } else {
                                                resetZoom();
                                            }
                                            lastTapTime = 0;
                                            return;
                                        }
                                        lastTapTime = now;

                                        // Swipe horizontally between photos if at scale 1
                                        if (zoomScale === 1 && e.changedTouches && e.changedTouches.length === 1) {
                                            var endX = e.changedTouches[0].clientX;
                                            var endY = e.changedTouches[0].clientY;
                                            var diffX = endX - touchStartX;
                                            var diffY = endY - touchStartY;
                                            if (Math.abs(diffX) > 50 && Math.abs(diffX) > Math.abs(diffY)) {
                                                if (diffX < 0) navigateZoom(1);  // Swipe left -> next
                                                else navigateZoom(-1);            // Swipe right -> prev
                                            }
                                        }

                                        if (zoomScale <= 1) {
                                            resetZoom();
                                        }
                                    }
                                }, { passive: true });

                                // Fullscreen Change Listener
                                document.addEventListener('fullscreenchange', function() {
                                    var fsBtn = document.getElementById('zoomFsBtn');
                                    if (fsBtn) {
                                        fsBtn.innerHTML = document.fullscreenElement ? '<i class="fas fa-compress"></i>' : '<i class="fas fa-expand"></i>';
                                    }
                                });

                                // Keyboard Navigation
                                window.addEventListener('keydown', function(e) {
                                    if (!modal.classList.contains('active')) return;
                                    if (e.key === 'Escape') {
                                        closeZoomModal();
                                    } else if (e.key === 'ArrowLeft') {
                                        navigateZoom(-1);
                                    } else if (e.key === 'ArrowRight') {
                                        navigateZoom(1);
                                    } else if (e.key === '+' || e.key === '=') {
                                        zoomIn();
                                    } else if (e.key === '-' || e.key === '_') {
                                        zoomOut();
                                    } else if (e.key === '0') {
                                        resetZoom();
                                    }
                                });
                            });
                        })();
                    </script>
                    <script>
                        // Add event listener for the Add to Cart button
                        document.getElementById('add-to-cart-btn')?.addEventListener('click', function () {
                            const quantity = parseInt(document.getElementById('quantity').value);
                            const productId = '<%= product._id %>';
                            const productName = '<%= product.name %>';

                            const headers = {
                                'Content-Type': 'application/json',
                            };

                            fetch('/myCart/add', {
                                method: 'POST',
                                headers: headers,
                                credentials: 'same-origin',
                                body: JSON.stringify({
                                    productId,
                                    quantity
                                })
                            })
                                .then(response => {
                                    if (!response.ok && response.redirected) {
                                        console.error('Server responded with non-OK status after redirect:', response.status);
                                    } else if (response.ok && !response.redirected) {
                                        // Show success notification
                                        showNotification(`${quantity} ${quantity === 1 ? 'item' : 'items'} of ${productName} added to your cart!`);
                                        window.location.reload();
                                    }
                                })
                                .catch(error => {
                                    console.error('Network or fetch error:', error);
                                    showNotification('Failed to add item to cart. Please try again.');
                                });
                        });

                        function showNotification(message) {
                            // Create notification element
                            const notification = document.createElement('div');
                            notification.className = 'custom-notification';
                            notification.innerHTML = `
                <i class="fas fa-check-circle"></i>
                <span class="message">${message}</span>
            `;

                            // Add to body
                            document.body.appendChild(notification);

                            // Show notification
                            setTimeout(() => {
                                notification.classList.add('show');
                            }, 100);

                            // Hide and remove after 4 seconds
                            setTimeout(() => {
                                notification.classList.remove('show');
                                setTimeout(() => {
                                    notification.remove();
                                }, 300);
                            }, 4000);
                        }

                        function validateQuantity(input) {
                            const max = parseInt(input.getAttribute('max'));
                            const value = parseInt(input.value);

                            if (value < 1) {
                                input.value = 1;
                            } else if (value > max) {
                                input.value = max;
                            }
                        }

                        function updateQuantity(change) {
                            const input = document.getElementById('quantity');
                            const newValue = parseInt(input.value) + change;
                            if (newValue >= 1 && newValue <= parseInt('<%= product.stock %>')) {
                                input.value = newValue;
                            }
                        }
                    </script>

