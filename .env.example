# ========================================================
# BRINGLY — Environment Variables Template
# Copy these into your Vercel Project Settings > Environment Variables
# ========================================================

# Environment
NODE_ENV=production
BASE_URL=https://your-app-name.vercel.app

# Database (MongoDB Atlas)
# Note: Ensure Network Access in MongoDB Atlas allows 0.0.0.0/0 (all IPs) for Vercel serverless
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/WebStore?retryWrites=true&w=majority

# Session Security
SESSION_SECRET=bringly_secure_session_secret_key_change_in_production

# Optional: Email Notifications & Password Reset (Gmail / SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_16_digit_google_app_password

# Optional: AI Shopping Assistant (OpenAI)
OPENAI_API_KEY=sk-...
